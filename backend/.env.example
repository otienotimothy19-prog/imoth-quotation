# Copy to .env and fill in for local development.
# In production, set these as real environment variables / secrets — never commit .env.

ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://imoth:imoth@localhost:5432/imoth_quotation

# Auth
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Document storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage/documents
STORAGE_PUBLIC_BASE_URL=/files

# SMTP / email (leave SMTP_HOST empty to disable sending; failures are logged, never fatal)
# Imoth sends from the Zoho Mail mailbox support@imoth.co.ke.
#   SMTP_HOST: smtppro.zoho.com for a company-domain Zoho account
#   (use smtppro.zoho.eu / smtppro.zoho.in if the account is in Zoho's EU / India data centre).
#   SMTP_PASSWORD: a Zoho *app-specific password* if two-factor sign-in is on for the mailbox.
#   Test with: python -m app.send_test_email you@example.com
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=587
SMTP_USERNAME=support@imoth.co.ke
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=support@imoth.co.ke
SMTP_FROM_NAME=Imoth Insurance Brokers

# Business defaults (overridable at runtime via Admin > Settings)
QUOTATION_VALIDITY_DAYS=30
LEVY_RATE=0.0045
STAMP_DUTY=40.0

# Security
# Emailed 6-digit login code after the password (needs SMTP above in
# production; in development without SMTP the code is printed in the server log).
LOGIN_OTP_ENABLED=true
LOGIN_OTP_TTL_MINUTES=10
# Lock an account for LOGIN_LOCKOUT_MINUTES after this many wrong passwords/codes in a row.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Header carrying the real visitor IP behind a load balancer
# (DigitalOcean App Platform: do-connecting-ip). Leave empty when not behind one.
CLIENT_IP_HEADER=
# Agents stay logged in on their device for this long between app launches.
AGENT_TOKEN_EXPIRE_DAYS=180

# Bootstrap admin — created by `python -m app.seed.seed_data` if it doesn't exist yet.
# Change this password immediately after first login.
BOOTSTRAP_ADMIN_EMAIL=admin@imoth.co.ke
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Public frontend origin used in short-lived quotation email links
PUBLIC_APP_URL=http://localhost:5173
