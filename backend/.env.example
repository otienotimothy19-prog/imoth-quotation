# Copy to .env and fill in for local development.
# In production, set these as real environment variables / secrets — never commit .env.

ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://imoth:imoth@localhost:5432/imoth_quotation

# Auth
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Document storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage/documents
STORAGE_PUBLIC_BASE_URL=/files

# SMTP / email (leave SMTP_HOST empty to disable sending; failures are logged, never fatal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@imoth.co.ke
SMTP_FROM_NAME=Imoth Insurance Brokers

# Business defaults (overridable at runtime via Admin > Settings)
QUOTATION_VALIDITY_DAYS=30
LEVY_RATE=0.0045
STAMP_DUTY=40.0

# Bootstrap admin — created by `python -m app.seed.seed_data` if it doesn't exist yet.
# Change this password immediately after first login.
BOOTSTRAP_ADMIN_EMAIL=admin@imoth.co.ke
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
